{
  "name": "@datacircle/lmstudio",
  "version": "0.1.0",
  "description": "LM Studio SDK tools on Datacircle's open API, for model.act(): find the best GTM APIs. List every API and see which provider ranks first on each one. Search every provider's pricing plans. See where a provider ranks. No API key needed.",
  "keywords": [
    "lmstudio",
    "lm-studio",
    "lmstudio-sdk",
    "local-llm",
    "act",
    "tool-use",
    "tool-calling",
    "tools",
    "gtm",
    "gtm-apis",
    "api",
    "api-directory",
    "api-pricing",
    "b2b-data",
    "data-enrichment",
    "datacircle"
  ],
  "homepage": "https://datacircle.dev",
  "bugs": {
    "url": "https://github.com/waynehamadi/lmstudio-datacircle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynehamadi/lmstudio-datacircle.git"
  },
  "license": "MIT",
  "author": "Datacircle <wayne@datacircle.dev> (https://datacircle.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "test": "npm run build && node test/live.mjs && node test/require.cjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@lmstudio/sdk": ">=1.2.0"
  },
  "devDependencies": {
    "@lmstudio/sdk": "2.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
